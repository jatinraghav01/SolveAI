# SolveAI Environment Variables Example

# App Configuration
NEXT_PUBLIC_APP_NAME="SolveAI"
NEXT_PUBLIC_APP_TAGLINE="One place to solve every problem."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Router Provider (default: 'keyword', optional: 'openai' | 'gemini')
AI_ROUTER_PROVIDER="keyword"
LLM_API_KEY="your_llm_api_key_here"

# Anime Finder Data Providers (Optional API Keys for real data providers)
# Jikan MAL API (Free, no key required)
JIKAN_API_BASE_URL="https://api.jikan.moe/v4"

# External Streaming Availability API Key (e.g. Streaming Availability API / JustWatch RapidAPI)
STREAMING_API_KEY="your_streaming_api_key_here"
STREAMING_API_HOST="streaming-availability.p.rapidapi.com"

# Future Database Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/solveai"
